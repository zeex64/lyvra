# Generates a .cpp holding one file as a byte array: <NAME>[] and <NAME>_size.
file(READ ${FILE} hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE ${OUT} "// Generated by embed_file.cmake. Do not edit.\n#include <cstddef>\n")
file(APPEND ${OUT} "extern const unsigned char ${NAME}[] = {${bytes}};\n")
file(APPEND ${OUT} "extern const size_t ${NAME}_size = sizeof(${NAME});\n")
