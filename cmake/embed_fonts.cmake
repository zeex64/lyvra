# Generates a .cpp holding each font as a byte array: <id>[] and <id>_size.
string(REPLACE "," ";" NAMES "${NAMES}")
file(WRITE ${OUT} "// Generated by embed_fonts.cmake. Do not edit.\n#include <cstddef>\n")
foreach(name ${NAMES})
  file(READ ${DIR}/${name}.ttf hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(MAKE_C_IDENTIFIER "font_${name}" id)
  file(APPEND ${OUT} "extern const unsigned char ${id}[] = {${bytes}};\n")
  file(APPEND ${OUT} "extern const size_t ${id}_size = sizeof(${id});\n")
endforeach()
