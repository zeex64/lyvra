#version 450
// AMD FidelityFX CAS (contrast adaptive sharpening), sharpen-only at native resolution.
#extension GL_GOOGLE_include_directive : require
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

layout(local_size_x = 64) in;
layout(binding = 0) uniform sampler2D inTex;
layout(rgba8, binding = 1) writeonly uniform image2D outImg;
layout(push_constant) uniform PC { uvec4 const0, const1, pad0, pad1; } pc;

AF3 CasLoad(ASU2 p) {
    ivec2 sz = textureSize(inTex, 0);
    return texelFetch(inTex, clamp(p, ivec2(0), sz - 1), 0).rgb;
}
void CasInput(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_cas.h"

void main() {
    AU2 gxy = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    AF4 c = AF4(0.0, 0.0, 0.0, 1.0);
    CasFilter(c.r, c.g, c.b, gxy, pc.const0, pc.const1, true);
    imageStore(outImg, ASU2(gxy), c);
    gxy.x += 8u;
    CasFilter(c.r, c.g, c.b, gxy, pc.const0, pc.const1, true);
    imageStore(outImg, ASU2(gxy), c);
    gxy.y += 8u;
    CasFilter(c.r, c.g, c.b, gxy, pc.const0, pc.const1, true);
    imageStore(outImg, ASU2(gxy), c);
    gxy.x -= 8u;
    CasFilter(c.r, c.g, c.b, gxy, pc.const0, pc.const1, true);
    imageStore(outImg, ASU2(gxy), c);
}
