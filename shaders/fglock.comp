#version 450
// Static-pixel lock for frame generation. A capture feed has no HUD-less copy, so game HUD
// text over a moving scene gets dragged along by the interpolation. Pixels that are identical
// in the previous and current real frame (across a 3x3 neighbourhood) can't have moved, so
// the generated frame takes the real pixel there. Also stores this frame for next time.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D cur;
layout(binding = 1) uniform sampler2D prev;
layout(rgba8, binding = 2) uniform image2D generated;
layout(rgba8, binding = 3) writeonly uniform image2D store;
layout(std430, binding = 4) readonly buffer Counter { uint sampled; uint failed; uint fast; } counter;
layout(push_constant) uniform PC { uint width; uint height; uint havePrev; uint debug; float maxFailed; } pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) return;
    vec3 c = texelFetch(cur, p, 0).rgb;
    imageStore(store, p, vec4(c, 1.0));
    if (pc.havePrev == 0u) return;
    // Too much of the frame unexplained by motion (fast pan, cut): show the real frame instead.
    if (counter.sampled > 0u && (float(counter.failed) > pc.maxFailed * float(counter.sampled) ||
                                 float(counter.fast) > 0.25 * float(counter.sampled) && pc.maxFailed < 1.0)) {
        imageStore(generated, p, vec4(pc.debug != 0u ? mix(c, vec3(1.0, 0.3, 0.2), 0.3) : c, 1.0));
        return;
    }
    // Per-pixel lock: an unchanged pixel (HUD text, crosshair) can't have moved.
    vec3 diff = abs(c - texelFetch(prev, p, 0).rgb);
    float d = max(diff.r, max(diff.g, diff.b));
    float lock = 1.0 - smoothstep(2.0 / 255.0, 6.0 / 255.0, d);
    if (lock <= 0.0) return;
    vec4 g = imageLoad(generated, p);
    vec3 outc = mix(g.rgb, c, lock);
    if (pc.debug != 0u) outc = mix(outc, vec3(0.2, 0.6, 1.0), lock * 0.5);
    imageStore(generated, p, vec4(outc, 1.0));
}
